# Normaliza los finales de línea: LF en el repositorio, nativos al descargar.
# Evita que el proyecto se marque como "modificado por completo" al editarlo
# desde otro sistema operativo.
* text=auto

# Binarios: que Git no los toque nunca.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.mp4  binary
